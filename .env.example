SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_POOL_SIZE=8
SUPABASE_STORAGE_BUCKET=scholarx-pdfs
DBLP_BATCH_SIZE=500
PDF_TASK_WORKERS=2
PDF_FILE_WORKERS=4
PDF_TITLE_LOOKUP_TIMEOUT_SECONDS=8

BACKEND_PORT=5000
FRONTEND_PORT=5180
VITE_API_URL=/api
CORS_ORIGINS=*
TZ=Asia/Shanghai

SCHEDULE_DBLP_ENABLED=true
SCHEDULE_DBLP_WEEKDAY=6
SCHEDULE_DBLP_HOUR=23
SCHEDULE_DBLP_MINUTE=30
SCHEDULE_DBLP_SKIP_CCF=true

# Supported protocols: anthropic, openai, google.
LLM_PROTOCOL=anthropic
LLM_BASE_URL=https://agent.nuwax.com/api/proxy/model/297238
LLM_API_KEY=
LLM_MODEL=glm-5.1

WEB_SEARCH_PROVIDER=bocha
WEB_SEARCH_RESULT_COUNT=10
WEB_SEARCH_CONCURRENCY=10
BOCHA_API_KEY=
BOCHA_SEARCH_URL=https://api.bocha.cn/v1/web-search
BOCHA_FRESHNESS=noLimit
BOCHA_SUMMARY=true
SKILL_ROOT=/app/skills
SKILL_STATE_PATH=/app/data/installed_skills.json
