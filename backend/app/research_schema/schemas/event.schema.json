{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "project_id",
    "actor",
    "activity",
    "target_objects",
    "input_refs",
    "output_refs",
    "status",
    "related_task",
    "provenance",
    "previous_hash",
    "sha256"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string"
    },
    "activity": {
      "type": "string"
    },
    "target_objects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "uniqueItems": true
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "output_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "pending",
        "in_progress",
        "blocked",
        "interrupted",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "related_task": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "kind",
        "actor",
        "sources"
      ],
      "properties": {
        "kind": {
          "enum": [
            "fact",
            "inference",
            "hypothesis"
          ]
        },
        "actor": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "previous_hash": {
      "type": "string"
    },
    "sha256": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
